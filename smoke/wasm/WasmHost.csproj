<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Console-style browser-wasm host, run headless under Node. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>WasmHost</AssemblyName>
    <RootNamespace>RecursiveAI.Smoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableThreads>false</WasmEnableThreads>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneCompress/OneCompress.csproj" />
    <ProjectReference Include="../../src/OneArchive/OneArchive.csproj" />
  </ItemGroup>

</Project>
