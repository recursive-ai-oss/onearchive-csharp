<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only project allowed to reference comparison libraries. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OneArchive.Bench</AssemblyName>
    <RootNamespace>RecursiveAI.Bench</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- bench/Micro is its own project. -->
    <Compile Remove="Micro/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/OneCompress/OneCompress.csproj" />
    <ProjectReference Include="../src/OneArchive/OneArchive.csproj" />
  </ItemGroup>

</Project>
