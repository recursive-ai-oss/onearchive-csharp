<Project Sdk="Microsoft.NET.Sdk">

  <!-- Micro-benchmarks (BenchmarkDotNet). Comparison libraries are referenced here only, never from src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OneArchive.Micro</AssemblyName>
    <RootNamespace>RecursiveAI.Bench.Micro</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1822;CA1707;CS1591;CA1812;CA2000;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneCompress/OneCompress.csproj" />
  </ItemGroup>

</Project>
