<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bar runner. The only project allowed to reference comparison libraries
       (used as black boxes for comparison rows; never shipped). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>OneArchive.Bar</AssemblyName>
    <RootNamespace>RecursiveAI.Bar</RootNamespace>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneCompress/OneCompress.csproj" />
    <ProjectReference Include="../../src/OneArchive/OneArchive.csproj" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
  </ItemGroup>

</Project>
