<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Test-only oracle for random cross-checks; used as a black box. -->
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneCompress/OneCompress.csproj" />
  </ItemGroup>

  <!-- Vectors written by the generators under testdata/, copied next to the test assembly. -->
  <ItemGroup>
    <Content Include="../../testdata/**/*.deflate;../../testdata/**/*.d64;../../testdata/**/*.zz;../../testdata/**/*.gz;../../testdata/**/*.bz2;../../testdata/**/*.xz;../../testdata/**/*.lzma;../../testdata/**/*.lz;../../testdata/**/*.zst;../../testdata/**/*.lz4;../../testdata/**/*.zdict;../../testdata/**/*.bin;../../testdata/**/*.tsv"
             Link="testdata/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Several tests allocate hundreds of megabytes; one test thread per core multiplies that on many-core machines. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
