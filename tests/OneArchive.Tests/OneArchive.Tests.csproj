<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The archive calls under test take an optional token; the tests leave it at its default. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <!-- Test vectors and generator scripts under testdata/, copied next to the test assembly (source paths are not
       available when the build maps them for reproducibility). -->
  <ItemGroup>
    <Content Include="../../testdata/7z/vectors/**/*;../../testdata/zip/*.py"
             Link="testdata/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/encryption/vectors/*.zip;../../testdata/encryption/vectors/*.7z"
             Link="testdata/encryption/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/cpio/*.cpio"
             Link="testdata/cpio/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/iso/vectors/*.iso"
             Link="testdata/iso/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/ar/*.a;../../testdata/ar/*.deb"
             Link="testdata/ar/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The LZX test compressor is shared with the codec tests so that cabinets with LZX folders can be built here. -->
  <ItemGroup>
    <Compile Include="../OneCompress.Tests/Lzx/LzxTestEncoder.cs" Link="Cab/LzxTestEncoder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneArchive/OneArchive.csproj" />
  </ItemGroup>

</Project>
