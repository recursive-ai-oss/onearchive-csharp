<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- The same host sources as ../Host, built for browser-wasm and run headless under Node. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>HashMatrix</AssemblyName>
    <RootNamespace>RecursiveAI.HashMatrix</RootNamespace>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableThreads>false</WasmEnableThreads>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Host/**/*.cs" Exclude="../Host/obj/**;../Host/bin/**" />
  </ItemGroup>

  <!-- The LZX test compressor and cabinet builder are shared with the tests so that the matrix can build streams to decode. -->
  <ItemGroup>
    <Compile Include="../../../tests/OneCompress.Tests/Lzx/LzxTestEncoder.cs" Link="Shared/LzxTestEncoder.cs" />
    <Compile Include="../../../tests/OneArchive.Tests/Cab/CabTestBuilder.cs" Link="Shared/CabTestBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/OneCompress/OneCompress.csproj" />
    <ProjectReference Include="../../../src/OneArchive/OneArchive.csproj" />
  </ItemGroup>

</Project>
